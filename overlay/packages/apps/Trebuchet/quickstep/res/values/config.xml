<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape-native clamshell: home screen must rotate by default. -->
<resources>
    <bool name="allow_rotation">true</bool>

    <!-- ThemePicker (com.android.wallpaper) is not installed. Empty means
         startWallpaperPicker leaves the intent unpinned so it still resolves. -->
    <string name="wallpaper_picker_package" translatable="false"></string>
</resources>
