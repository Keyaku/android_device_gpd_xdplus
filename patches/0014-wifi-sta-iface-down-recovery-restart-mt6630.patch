diff --git a/service/java/com/android/server/wifi/SelfRecovery.java b/service/java/com/android/server/wifi/SelfRecovery.java
index b7eb723..7c9374e 100644
--- a/service/java/com/android/server/wifi/SelfRecovery.java
+++ b/service/java/com/android/server/wifi/SelfRecovery.java
@@ -91,8 +91,28 @@ public class SelfRecovery {
             return;
         }
         if (reason == REASON_STA_IFACE_DOWN) {
-            Log.e(TAG, "STA interface down, disable wifi");
-            mActiveModeWarden.recoveryDisableWifi();
+            // On the MT6630 combo chip, STA iface down is a transient side
+            // effect of a BT firmware assert crashing the shared SDIO
+            // function — the WMT layer does a whole-chip reset, wlan0 is
+            // unregistered, and the framework sees CMD_INTERFACE_DOWN.
+            // The kernel's own wifi_reset_end recovers wlan0 once STP settles
+            // (~2-3 min), but the default "disable + never re-enable" parks
+            // Wi-Fi before that recovery completes. Restart (toggle off->on
+            // with delay) instead, so the framework retries after the combo
+            // chip has recovered. Throttle like WIFINATIVE_FAILURE to avoid
+            // infinite restart loops if the iface is genuinely broken.
+            Log.e(TAG, "STA interface down, attempting recovery restart");
+            int maxRecoveriesPerHour = mContext.getResources().getInteger(
+                    R.integer.config_wifiMaxNativeFailureSelfRecoveryPerHour);
+            if (maxRecoveriesPerHour == 0
+                    || mPastRestartTimes.size() >= maxRecoveriesPerHour) {
+                Log.e(TAG, "STA iface down recovery throttled, disabling wifi");
+                mActiveModeWarden.recoveryDisableWifi();
+                return;
+            }
+            trimPastRestartTimes();
+            mPastRestartTimes.add(mClock.getElapsedSinceBootMillis());
+            mActiveModeWarden.recoveryRestartWifi(reason);
             return;
         }
 
