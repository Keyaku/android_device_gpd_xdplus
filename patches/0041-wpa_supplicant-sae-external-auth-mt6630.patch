From: António Sarmento <...>
Date: Tue, 18 Aug 2026 22:00:00 +0000
Subject: [PATCH] wpa_supplicant: SAE external auth on MT6630 gen3

Three pieces are needed for an SAE-only 5 GHz association on the MT6630
(gen3) driver with kernel-side external authentication backported to 3.18:

1. Receive NL80211_CMD_EXTERNAL_AUTH on the global socket. The 3.18
   backport has no conn-owner unicast, so the event arrives via
   do_process_drv_event(), which had no case for it.

2. Pass the target BSS frequency into SAE commit/confirm transmission.
   sme_external_auth_send_sae_{commit,confirm}() called
   wpa_drv_send_mlme() with freq=0; the gen3 driver rejects the frame
   because it has no current channel grant when the auth exchange is
   userspace-driven.

3. Bypass the monitor-interface path for SAE auth frames. The driver
   selects use_monitor=1 because it lacks data-tx-status, but no monitor
   interface is created in STA mode, so nl80211_send_monitor() fails with
   "No monitor socket available". Route SAE Authentication frames through
   NL80211_CMD_FRAME instead.

With these, a private SAE-capable wpa_supplicant completes
CTRL-EVENT-CONNECTED to an SAE-only AP (Onome 5GHz, 5580 MHz).
---
diff --git a/src/drivers/driver_nl80211.c b/src/drivers/driver_nl80211.c
index 34bd7ec..91b8797 100644
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -3929,6 +3929,26 @@ static int wpa_driver_nl80211_send_mlme(struct i802_bss *bss, const u8 *data,
 		freq = bss->freq;
 	}
 
+	/*
+	 * SAE external auth sends commit/confirm through this path. The
+	 * kernel/gen3 driver does not have a monitor interface available for
+	 * STA mode, so route SAE authentication frames through the nl80211
+	 * frame command even if the driver otherwise selects use_monitor.
+	 */
+	if (drv->use_monitor &&
+	    drv->nlmode == NL80211_IFTYPE_STATION &&
+	    (drv->capa.flags & WPA_DRIVER_FLAGS_SAE) &&
+	    !(drv->capa.flags & WPA_DRIVER_FLAGS_SME) &&
+	    WLAN_FC_GET_TYPE(fc) == WLAN_FC_TYPE_MGMT &&
+	    WLAN_FC_GET_STYPE(fc) == WLAN_FC_STYPE_AUTH &&
+	    le_to_host16(mgmt->u.auth.auth_alg) == WLAN_AUTH_SAE) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: SAE auth frame - bypass monitor interface");
+		goto send_frame_cmd;
+	}
+
+	wpa_printf(MSG_DEBUG, "nl80211: send_mlme use_monitor=%d freq=%u bss->freq=%u",
+		   drv->use_monitor, freq, bss->freq);
 	if (drv->use_monitor) {
 		wpa_printf(MSG_DEBUG,
 			   "nl80211: send_frame(freq=%u bss->freq=%u) -> send_monitor",
@@ -8260,6 +8280,7 @@ static int nl80211_set_param(void *priv, const char *param)
 
 	if (os_strstr(param, "use_monitor=1"))
 		drv->use_monitor = 1;
+	wpa_printf(MSG_DEBUG, "nl80211: parsed use_monitor=%d", drv->use_monitor);
 
 	if (os_strstr(param, "force_connect_cmd=1")) {
 		drv->capa.flags &= ~WPA_DRIVER_FLAGS_SME;
diff --git a/src/drivers/driver_nl80211_event.c b/src/drivers/driver_nl80211_event.c
index dbe3276..92d1d89 100644
--- a/src/drivers/driver_nl80211_event.c
+++ b/src/drivers/driver_nl80211_event.c
@@ -2835,6 +2835,13 @@ static void do_process_drv_event(struct i802_bss *bss, int cmd,
 			mlme_event_unprot_beacon(drv, nla_data(frame),
 						 nla_len(frame));
 		break;
+	case NL80211_CMD_EXTERNAL_AUTH:
+		/* The kernel multicasts this on the MLME group (3.18 has no
+		 * conn-owner unicast), so it arrives here via the global
+		 * socket, not the per-BSS one that has its own case below.
+		 */
+		nl80211_external_auth(drv, tb);
+		break;
 	default:
 		wpa_dbg(drv->ctx, MSG_DEBUG, "nl80211: Ignored unknown event "
 			"(cmd=%d)", cmd);
diff --git a/wpa_supplicant/sme.c b/wpa_supplicant/sme.c
index d06f6e2..a240fcd 100644
--- a/wpa_supplicant/sme.c
+++ b/wpa_supplicant/sme.c
@@ -1004,7 +1004,8 @@ static int sme_external_auth_build_buf(struct wpabuf *buf,
 
 static int sme_external_auth_send_sae_commit(struct wpa_supplicant *wpa_s,
 					     const u8 *bssid,
-					     struct wpa_ssid *ssid)
+					     struct wpa_ssid *ssid,
+					     unsigned int freq)
 {
 	struct wpabuf *resp, *buf;
 	int use_pt;
@@ -1027,7 +1028,7 @@ static int sme_external_auth_send_sae_commit(struct wpa_supplicant *wpa_s,
 				    bssid, 1, wpa_s->sme.seq_num,
 				    use_pt ? WLAN_STATUS_SAE_HASH_TO_ELEMENT :
 				    WLAN_STATUS_SUCCESS);
-	wpa_drv_send_mlme(wpa_s, wpabuf_head(buf), wpabuf_len(buf), 1, 0, 0);
+	wpa_drv_send_mlme(wpa_s, wpabuf_head(buf), wpabuf_len(buf), 1, freq, 0);
 	wpabuf_free(resp);
 	wpabuf_free(buf);
 
@@ -1055,6 +1056,7 @@ static int sme_handle_external_auth_start(struct wpa_supplicant *wpa_s,
 					  union wpa_event_data *data)
 {
 	struct wpa_ssid *ssid;
+	struct wpa_bss *bss;
 	size_t ssid_str_len = data->external_auth.ssid_len;
 	const u8 *ssid_str = data->external_auth.ssid;
 
@@ -1066,9 +1068,25 @@ static int sme_handle_external_auth_start(struct wpa_supplicant *wpa_s,
 		    (ssid->key_mgmt & (WPA_KEY_MGMT_SAE | WPA_KEY_MGMT_FT_SAE)))
 			break;
 	}
-	if (!ssid ||
-	    sme_external_auth_send_sae_commit(wpa_s, data->external_auth.bssid,
-					      ssid) < 0)
+	if (!ssid)
+		return -1;
+
+	/*
+	 * The external-auth path is entered before wpa_supplicant_associate()
+	 * has set current_bss / assoc_freq, but nl80211 send_mlme needs a
+	 * channel.  Look up the BSS from the BSSID/SSID in the event and pin
+	 * the association frequency now.
+	 */
+	bss = wpa_bss_get(wpa_s, data->external_auth.bssid, ssid_str,
+			  ssid_str_len);
+	if (bss) {
+		wpa_s->current_bss = bss;
+		wpa_s->assoc_freq = bss->freq;
+	}
+
+	if (sme_external_auth_send_sae_commit(wpa_s, data->external_auth.bssid,
+					      ssid,
+					      bss ? bss->freq : 0) < 0)
 		return -1;
 
 	return 0;
@@ -1079,6 +1097,7 @@ static void sme_external_auth_send_sae_confirm(struct wpa_supplicant *wpa_s,
 					       const u8 *da)
 {
 	struct wpabuf *resp, *buf;
+	unsigned int freq = wpa_s->current_bss ? wpa_s->current_bss->freq : 0;
 
 	resp = sme_auth_build_sae_confirm(wpa_s, 1);
 	if (!resp) {
@@ -1097,7 +1116,7 @@ static void sme_external_auth_send_sae_confirm(struct wpa_supplicant *wpa_s,
 	sme_external_auth_build_buf(buf, resp, wpa_s->own_addr,
 				    da, 2, wpa_s->sme.seq_num,
 				    WLAN_STATUS_SUCCESS);
-	wpa_drv_send_mlme(wpa_s, wpabuf_head(buf), wpabuf_len(buf), 1, 0, 0);
+	wpa_drv_send_mlme(wpa_s, wpabuf_head(buf), wpabuf_len(buf), 1, freq, 0);
 	wpabuf_free(resp);
 	wpabuf_free(buf);
 }
@@ -1251,7 +1270,8 @@ static int sme_sae_auth(struct wpa_supplicant *wpa_s, u16 auth_transaction,
 		else
 			sme_external_auth_send_sae_commit(
 				wpa_s, wpa_s->sme.ext_auth_bssid,
-				wpa_s->current_ssid);
+				wpa_s->current_ssid,
+				wpa_s->current_bss ? wpa_s->current_bss->freq : 0);
 		return 0;
 	}
 
@@ -1272,7 +1292,8 @@ static int sme_sae_auth(struct wpa_supplicant *wpa_s, u16 auth_transaction,
 		else
 			sme_external_auth_send_sae_commit(
 				wpa_s, wpa_s->sme.ext_auth_bssid,
-				wpa_s->current_ssid);
+				wpa_s->current_ssid,
+				wpa_s->current_bss ? wpa_s->current_bss->freq : 0);
 		return 0;
 	}
 
