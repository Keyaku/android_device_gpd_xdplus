From 65c9d1662beaaeff5fe397f401cad72b13eedf21 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ant=C3=B3nio=20Sarmento?= <Keyaku@users.noreply.github.com>
Date: Sun, 26 Jul 2026 15:38:04 +0100
Subject: [PATCH] SurfaceFlinger: watchdog for a composer that stops delivering
 hardware vsync

The GPD XD+'s vendor composer can stop generating vsync while still reporting it
as enabled ("vsync : 1" in its own dump) with its VSyncThread_0 parked on an
internal condvar instead of waiting on kernel vsync. SF then dispatches no vsync,
composes nothing, and both displays freeze with the hardware still scanning out.
The hotplug re-arm added previously cannot cover it, because the composer drops
vsync asynchronously, after hotplug processing has already returned.

Stage 1 (on by default) is a forced HWC vsync off/on, which measurably does
recover the primary display sometimes but not reliably. Stage 2 is the
programmatic equivalent of the screen off/on cycle that always works, but it is
DEFAULT OFF: driving display power from inside SF goes behind
PowerManagerService's back, and system_server died shortly after it ran in
testing (root cause unproven, correlation sufficient). PowerManagerService is the
right long-term home for that escalation.

Changes:
- Add a `OneShotTimer`-based watchdog, reset by every vsync in `onVsyncReceived()` and by `setPrimaryVsyncEnabledInternal()`, so it expires only when vsync stops while believed enabled (500 ms)
- Escalate on timeout: two forced HWC vsync off/on kicks via the extracted `kickHWCVsyncLocked()`, then optionally an internal-display power bounce gated on `persist.sys.xdplus.vsync_watchdog_bounce` (default false), logging once per stall when the bounce is skipped
- Verified: no spurious kicks across 15-20 s idle or a healthy 61/s baseline; kicks fire within 500 ms of a real stall

Co-authored-by: Claude <noreply@anthropic.com>
Change-Id: Ic344a8e7bf51dbc9ab4deca6347c28838d06a0b7
---
 services/surfaceflinger/SurfaceFlinger.cpp | 129 ++++++++++++++++++---
 services/surfaceflinger/SurfaceFlinger.h   |  12 ++
 2 files changed, 127 insertions(+), 14 deletions(-)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index dcb2b27117..ae33f6d8ca 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -1604,6 +1604,13 @@ void SurfaceFlinger::onVsyncReceived(int32_t sequenceId, hal::HWDisplayId hwcDis
         return;
     }
 
+    // GPD XD+ (§103): hardware vsync is alive, so hold the watchdog off and clear
+    // the escalation counter.
+    if (mHWVsyncWatchdog) {
+        mHWVsyncWatchdogAttempts = 0;
+        mHWVsyncWatchdog->reset();
+    }
+
     bool periodFlushed = false;
     mScheduler->addResyncSample(timestamp, vsyncPeriod, &periodFlushed);
     if (periodFlushed) {
@@ -1706,6 +1713,13 @@ void SurfaceFlinger::setPrimaryVsyncEnabledInternal(bool enabled) {
             getHwComposer().setVsyncEnabled(*displayId, mHWCVsyncPendingState);
         }
     }
+
+    // GPD XD+ (§103): start the watchdog's window fresh when vsync is turned on,
+    // so the first check happens a full timeout after the request rather than
+    // inheriting a stale deadline.
+    if (mHWVsyncWatchdog && enabled) {
+        mHWVsyncWatchdog->reset();
+    }
 }
 
 void SurfaceFlinger::resetDisplayState() {
@@ -2500,31 +2514,111 @@ void SurfaceFlinger::processDisplayHotplugEventsLocked() {
     mPendingHotplugEvents.clear();
 
     // GPD XD+ (§102): re-arm the primary display's HWC vsync after any hotplug.
+    // See kickHWCVsyncLocked(). This covers the synchronous case; the watchdog
+    // in §103 covers the vendor composer dropping vsync asynchronously, after
+    // this function has already returned.
+    kickHWCVsyncLocked();
+}
+
+void SurfaceFlinger::kickHWCVsyncLocked() {
+    // GPD XD+ (§102/§103): force the internal display's HWC vsync off and back
+    // on to resynchronize a composer that has silently stopped generating it.
     //
     // setPrimaryVsyncEnabledInternal() stores mHWCVsyncPendingState but only
-    // pushes it to HWC when the internal display exists and is powered on, and
+    // pushes it to HWC while the internal display exists and is powered on, and
     // nothing re-applies it afterwards except an OFF -> ON power transition. An
     // external hotplug (the mini-HDMI mirror coming or going) can leave the
     // composer with vsync generation stopped while SF still believes it is
     // enabled: SF then dispatches no vsync at all, composes nothing, and BOTH
     // displays freeze with the hardware still scanning out. Measured in that
     // state: "mLastDispatchTime: 43368 ms ago", the composer's VSyncThread_0
-    // parked in futex rather than waiting on kernel vsync, and only an
-    // off/on screen cycle recovering it.
+    // parked in futex rather than waiting on kernel vsync, and only an off/on
+    // screen cycle recovering it.
     //
-    // HWComposer::setVsyncEnabled() early-returns when the requested state
-    // matches its cached value, so a plain re-request cannot resynchronize a
-    // composer that has silently stopped. Force the transition instead: drop to
-    // DISABLE and immediately restore the pending state, which makes HWC issue
-    // both calls for real.
-    if (const auto displayId = getInternalDisplayIdLocked()) {
-        const sp<DisplayDevice> display = getDefaultDisplayDeviceLocked();
-        if (display && display->isPoweredOn() &&
-            mHWCVsyncPendingState == hal::Vsync::ENABLE) {
-            getHwComposer().setVsyncEnabled(*displayId, hal::Vsync::DISABLE);
-            getHwComposer().setVsyncEnabled(*displayId, hal::Vsync::ENABLE);
+    // The forcing is the point: HWComposer::setVsyncEnabled() early-returns when
+    // the requested state matches its cached value, so a plain re-request cannot
+    // recover a composer whose vsync thread has stopped. Dropping to DISABLE
+    // first makes HWC issue both calls for real.
+    if (mHWCVsyncPendingState != hal::Vsync::ENABLE) {
+        return;
+    }
+
+    const auto displayId = getInternalDisplayIdLocked();
+    if (!displayId) {
+        return;
+    }
+
+    const sp<DisplayDevice> display = getDefaultDisplayDeviceLocked();
+    if (!display || !display->isPoweredOn()) {
+        return;
+    }
+
+    getHwComposer().setVsyncEnabled(*displayId, hal::Vsync::DISABLE);
+    getHwComposer().setVsyncEnabled(*displayId, hal::Vsync::ENABLE);
+}
+
+void SurfaceFlinger::onHWVsyncWatchdogTimeout() {
+    // GPD XD+ (§103): no hardware vsync has arrived for kHWVsyncWatchdogTimeout
+    // while we believe it is enabled, so the composer has stopped delivering it
+    // and SF has lost its clock (nothing composes, both displays freeze with the
+    // hardware still scanning out).
+    //
+    // Escalate in two stages, because a vsync toggle alone provably does not
+    // always clear it: the vendor composer can end up believing vsync is enabled
+    // (its dump says "vsync : 1") while its own VSyncThread_0 sits parked on an
+    // internal condvar instead of waiting on kernel vsync. That is a wedge inside
+    // the composer, and only rebuilding its display state clears it — which is
+    // what a screen off/on cycle does, the one recovery known to work.
+    //
+    // Stage 1 (first kHWVsyncKickAttempts timeouts): force the HWC vsync
+    // off/on. Cheap and invisible.
+    // Stage 2: bounce the internal display's power mode OFF -> ON, i.e. the
+    // screen cycle, done programmatically. DEFAULT OFF, opt in with
+    //   setprop persist.sys.xdplus.vsync_watchdog_bounce 1
+    // Driving display power from inside SF goes behind PowerManagerService's
+    // back, and during testing system_server died shortly after this stage ran
+    // (root cause unproven — logcat had already rolled — but the correlation is
+    // reason enough not to ship it enabled). Stage 1 is safe and stays on; if the
+    // freeze needs stage 2, the right long-term home for it is
+    // PowerManagerService, which actually owns display power.
+    const int attempt = ++mHWVsyncWatchdogAttempts;
+
+    if (attempt <= kHWVsyncKickAttempts) {
+        ALOGW("HW vsync watchdog: no vsync for %lld ms while enabled, kicking HWC vsync "
+              "(attempt %d/%d)",
+              static_cast<long long>(kHWVsyncWatchdogTimeout.count()), attempt,
+              kHWVsyncKickAttempts);
+        static_cast<void>(schedule([this]() MAIN_THREAD { kickHWCVsyncLocked(); }));
+        return;
+    }
+
+    if (!base::GetBoolProperty("persist.sys.xdplus.vsync_watchdog_bounce"s, false)) {
+        // Log once per stall rather than every timeout.
+        if (attempt == kHWVsyncKickAttempts + 1) {
+            ALOGW("HW vsync watchdog: vsync still dead after %d kicks; power bounce disabled "
+                  "(persist.sys.xdplus.vsync_watchdog_bounce=0). Recover with a screen off/on "
+                  "cycle.",
+                  kHWVsyncKickAttempts);
         }
+        return;
     }
+
+    ALOGW("HW vsync watchdog: vsync still dead after %d kicks, bouncing internal display power",
+          kHWVsyncKickAttempts);
+
+    static_cast<void>(schedule([this]() MAIN_THREAD {
+        const sp<DisplayDevice> display = getDefaultDisplayDeviceLocked();
+        if (!display || !display->isPoweredOn()) {
+            return;
+        }
+
+        // OFF then back ON rebuilds the composer's per-display state and
+        // re-issues the vsync enable through setPowerModeInternal()'s own
+        // OFF -> ON path, which is the sequence that recovers the freeze.
+        setPowerModeInternal(display, hal::PowerMode::OFF);
+        setPowerModeInternal(display, hal::PowerMode::ON);
+        mHWVsyncWatchdogAttempts = 0;
+    }));
 }
 
 void SurfaceFlinger::dispatchDisplayHotplugEvent(PhysicalDisplayId displayId, bool connected) {
@@ -3070,6 +3164,13 @@ void SurfaceFlinger::initScheduler(DisplayId primaryDisplayId) {
             mRefreshRateConfigs->getRefreshRateFromConfigId(currentConfig).getVsyncPeriod();
     mScheduler->onPrimaryDisplayConfigChanged(mAppConnectionHandle, primaryDisplayId.value,
                                               currentConfig, vsyncPeriod);
+
+    // GPD XD+ (§103): hardware-vsync watchdog. onVsyncReceived() resets it, so it
+    // only expires when the composer has stopped delivering vsync while we
+    // believe it is enabled — see onHWVsyncWatchdogTimeout().
+    mHWVsyncWatchdog.emplace(kHWVsyncWatchdogTimeout, []() {} /* resetCallback */,
+                             [this] { onHWVsyncWatchdogTimeout(); });
+    mHWVsyncWatchdog->start();
 }
 
 void SurfaceFlinger::commitTransaction()
diff --git a/services/surfaceflinger/SurfaceFlinger.h b/services/surfaceflinger/SurfaceFlinger.h
index 642eed05b4..9ea1344e5b 100644
--- a/services/surfaceflinger/SurfaceFlinger.h
+++ b/services/surfaceflinger/SurfaceFlinger.h
@@ -1219,6 +1219,18 @@ private:
     nsecs_t mScheduledPresentTime = 0;
     hal::Vsync mHWCVsyncPendingState = hal::Vsync::DISABLE;
 
+    // GPD XD+ (§102/§103): recover from a composer that stops delivering
+    // hardware vsync while SF still believes it is enabled, which otherwise
+    // freezes both displays until a screen off/on cycle. The watchdog is reset by
+    // every vsync in onVsyncReceived(), so it only expires when they stop.
+    static constexpr scheduler::OneShotTimer::Interval kHWVsyncWatchdogTimeout{500};
+    // Cheap vsync off/on kicks first; only then the visible power-mode bounce.
+    static constexpr int kHWVsyncKickAttempts = 2;
+    std::optional<scheduler::OneShotTimer> mHWVsyncWatchdog;
+    std::atomic<int> mHWVsyncWatchdogAttempts = 0;
+    void kickHWCVsyncLocked() REQUIRES(mStateLock);
+    void onHWVsyncWatchdogTimeout();
+
     /* ------------------------------------------------------------------------
      * Generic Layer Metadata
      */
-- 
2.55.0

