From 2f41ab74d97c10698aa6cbd222a2ebf9e1e0d3b6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ant=C3=B3nio=20Sarmento?= <Keyaku@users.noreply.github.com>
Date: Sun, 26 Jul 2026 20:45:24 +0100
Subject: [PATCH] SurfaceFlinger: forced validate for the internal display --
 KNOWN-BAD

Earlier tracing found that while the HDMI mirror runs the vendor composer prepares
display 0's layer 0 against one frozen ion fd and stops preparing layers
1-2 at all, so every fresh buffer index the kernel receives resolves to
one stale MVA and the panel freezes. The same bug class had been fixed on
display 1 -- the blob reusing cached per-display state -- by forcing the
slow validate/present path, so the obvious thing to try was the same for
the internal display while a second display is attached.

It does not work. Applied live to an already-working mirror, the external
display is dropped outright: `DisplayDevice{1` disappears, ext triggers go
to 0, and the panel then runs at a healthy 61/s with its OVL address
moving again only because the device is back to a single display. There is
no evidence the blob refreshes display 0's ion fd while a mirror is
actually up.

Kept behind `persist.sys.xdplus.prim_force_validate`, **default off and
KNOWN-BAD**, so the lever is documented rather than silently re-tried.

Co-authored-by: Claude <noreply@anthropic.com>
Change-Id: Idf0a0db130ba904310e02c233c157dd5b0ca4b0f
---
 .../DisplayHardware/HWComposer.cpp              | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/services/surfaceflinger/DisplayHardware/HWComposer.cpp b/services/surfaceflinger/DisplayHardware/HWComposer.cpp
index 5c96310586..ff78285a98 100644
--- a/services/surfaceflinger/DisplayHardware/HWComposer.cpp
+++ b/services/surfaceflinger/DisplayHardware/HWComposer.cpp
@@ -511,10 +511,25 @@ status_t HWComposer::getDeviceCompositionChanges(
     // renders a client target, so HWC bypasses the display forever
     // ("[JOB] (1) SET/bypass/no layers") and the monitor stays dark. Take the slow
     // validate/present path for external displays.
-    const bool forceValidate = !displayData.isVirtual &&
+    bool forceValidate = !displayData.isVirtual &&
             getDisplayConnectionType(displayId) == DisplayConnectionType::External &&
             property_get_bool("persist.sys.xdplus.hdmi_force_validate", 1);
 
+    // The same bug class, one display over. While a mirror is up the blob
+    // stops rebuilding the INTERNAL display's layer set: it prepares only layer 0
+    // and always against the same ion fd, so every fresh buffer index the kernel
+    // receives resolves to one stale MVA and the built-in panel freezes.
+    // Forcing the slow validate/present path made the blob rebuild the external
+    // display's state above; try the same for the internal display, but only while
+    // a second physical display is actually attached, so the normal single-display
+    // case keeps its skip-validate fast path.
+    if (!forceValidate && !displayData.isVirtual &&
+        getDisplayConnectionType(displayId) == DisplayConnectionType::Internal &&
+        mPhysicalDisplayIdMap.size() > 1 &&
+        property_get_bool("persist.sys.xdplus.prim_force_validate", 0)) {
+        forceValidate = true;
+    }
+
     displayData.validateWasSkipped = false;
     if (!frameUsesClientComposition && !forceValidate) {
         sp<Fence> outPresentFence;
-- 
