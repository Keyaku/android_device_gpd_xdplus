+    /**
+     * Frequency of the link being established, or -1 when it is not known yet.
+     *
+     * WifiInfo carries the previous link's frequency (or -1 after a reset) until
+     * the scan cache lookup in handleSupplicantStateChange() or the first RSSI
+     * poll updates it, so fall back to the scan cache for the current BSSID.
+     */
+    private int getCurrentFrequencyMhz() {
+        int frequencyMhz = mWifiInfo.getFrequency();
+        if (frequencyMhz > 0) {
+            return frequencyMhz;
+        }
+        String bssid = mWifiInfo.getBSSID();
+        ScanDetailCache scanDetailCache =
+                mWifiConfigManager.getScanDetailCacheForNetwork(mWifiInfo.getNetworkId());
+        if (bssid == null || scanDetailCache == null) {
+            return -1;
+        }
+        ScanDetail scanDetail = scanDetailCache.getScanDetail(bssid);
+        if (scanDetail == null) {
+            return -1;
+        }
+        return scanDetail.getScanResult().frequency;
+    }
