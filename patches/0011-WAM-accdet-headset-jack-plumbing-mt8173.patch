+    // xdplus: polls the MT8173 accdet sysfs and feeds the h2w headset bits through
+    // the normal updateLocked() path, so routing, speaker mute, headset-mic
+    // availability and the ACTION_HEADSET_PLUG status-bar icon all work despite the
+    // missing /sys/class/switch/h2w node. accdet exposes no usable uevent/poll to
+    // Java, so a light sysfs poll is used.
+    final class AccdetObserver extends Thread {
+        AccdetObserver() {
+            super("AccdetObserver");
+        }
+
+        @Override
+        public void run() {
+            int lastRaw = -1;
+            while (true) {
+                int raw = readAccdetState();
+                if (raw >= 0 && raw != lastRaw) {
+                    lastRaw = raw;
+                    int headset;
+                    switch (raw) {
+                        case 1:  headset = BIT_HEADSET; break;         // 4-pole, with mic
+                        case 2:  headset = BIT_HEADSET_NO_MIC; break;  // 3-pole, no mic
+                        default: headset = 0; break;                   // 0 = unplugged
+                    }
+                    synchronized (mLock) {
+                        updateLocked(NAME_H2W, "",
+                                (mHeadsetState & ~(BIT_HEADSET | BIT_HEADSET_NO_MIC | BIT_LINEOUT))
+                                        | headset);
+                    }
+                }
+                try {
+                    Thread.sleep(ACCDET_POLL_INTERVAL_MS);
+                } catch (InterruptedException e) {
+                    return;
+                }
+            }
+        }
+
+        private int readAccdetState() {
+            char[] buffer = new char[16];
+            try (FileReader file = new FileReader(ACCDET_STATE_PATH)) {
+                int len = file.read(buffer, 0, buffer.length);
+                if (len <= 0) return -1;
+                return Integer.parseInt(new String(buffer, 0, len).trim());
+            } catch (IOException | NumberFormatException e) {
+                return -1;
+            }
+        }
+    }
+
