// System-side replacement for the crash-looping vendor configstore HAL.
// See service.cpp for the full story.
cc_binary {
	name: "android.hardware.configstore@1.1-service.xdplus",
	relative_install_path: "hw",
	init_rc: ["android.hardware.configstore@1.1-service.xdplus.rc"],
	srcs: ["service.cpp"],
	shared_libs: [
		"libhidlbase",
		"libbase",
		"liblog",
		"libutils",
		"android.hardware.configstore@1.0",
		"android.hardware.configstore@1.1",
	],
}
