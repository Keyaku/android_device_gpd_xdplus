#
# system.prop for xdplus
#
rild.libpath=mtk-ril.so
rild.libargs=-d /dev/ttyC0


# MTK, Infinity, 20090720 {
wifi.interface=wlan0
ro.hardware=xdplus
# MTK, Infinity, 20090720 }

# MTK, mtk03034, 20101210 {
ro.mediatek.wlan.wsc=1
# MTK, mtk03034 20101210}
# MTK, mtk03034, 20110318 {
ro.mediatek.wlan.p2p=1
# MTK, mtk03034 20110318}

# MTK, mtk03034, 20101213 {
mediatek.wlan.ctia=0
# MTK, mtk03034 20101213}


#
wifi.tethering.interface=ap0
#
ro.sf.lcd_density=240
ro.opengles.version=196610

# Vulkan loader derives the HAL name from this (vulkan.<value>.so); empty here
# meant the loader never found /vendor/lib64/hw/vulkan.mt8173.so (0 phys devices).
ro.hardware.vulkan=mt8173

wifi.direct.interface=p2p0
dalvik.vm.heapgrowthlimit=128m
dalvik.vm.heapsize=256m

# USB MTP WHQL
ro.sys.usb.mtp.whql.enable=0

# Power off opt in IPO
sys.ipo.pwrdncap=2

ro.sys.usb.storage.type=mtp,adb

# USB BICR function
ro.sys.usb.bicr=no

# USB Charge only function
ro.sys.usb.charging.only=yes

# audio
ro.camera.sound.forced=0
ro.audio.silent=0

ro.zygote.preload.enable=0

ro.kernel.zio=38,108,105,16
ro.boot.selinux=disable

debug.hwui.render_dirty_regions=false

ro.mediatek.chip_ver=S01
ro.mediatek.version.release=alps-mp-n0.mp12-V1.9_wisky8176.tb.n_P5
ro.mediatek.platform=MT8173
ro.mediatek.version.sdk=4
ro.telephony.default_network=0
ril.first.md=1
ril.flightmode.poweroffMD=0
ril.telephony.mode=0
persist.mtk.wcn.combo.chipid=-1
ril.specific.sm_cause=0
bgw.current3gband=0
ro.sf.hwrotation=180
ril.radiooff.poweroffMD=0

persist.sys.flat_rotation=1

# OTA manifest URI for the LineageOS Updater.
#
# Payloads are published as release assets on the public umbrella repository,
# and the manifest is fetched as a static file over HTTPS with a publicly
# trusted certificate, so nothing needs baking into the system trust store.
#
# The Updater builds its request with a plain string replace of {device},
# {type} and {incr}, so those placeholders are OPTIONAL: a literal URL is
# fetched verbatim, which is what a static host wants.
#
# The repository must stay public. Both this manifest and the release asset it
# points at are fetched anonymously, and a token must never appear here — this
# file ships inside system.img and would be readable on every device.
lineage.updater.uri=https://raw.githubusercontent.com/Keyaku/gpd-xdplus-customrom/main/ota/xdplus.json

# MTK gen2 driver mishandles 802.11 power-save: APs low-ack-kick the device
# mid-transfer. Patch 0011 pins framework power-save off
# when this is set; init.xdplus.rc covers the raw driver default at load time.
persist.sys.wifi_ps_pin_off=1

# (The MT6630 PHY-mode label fix is unconditional in patch 0013 and needs no
# property. It used to be gated on persist.sys.wifi_standard_11n_fallback,
# which only chose between a correct badge and a wrong one. The comment that
# lived here also claimed the chip was HT-only, which is false: 5 GHz VHT80 was
# later measured working, and the patch labels by band.)

# Flutter Impeller crashes on this device: the engine falls back off Vulkan on
# its own, then Impeller GL-ES fails to choose an offscreen EGL config and
# dereferences the null context ("Could not choose offscreen config", SIGSEGV
# at 0x18 on the 1.raster thread). Measured identical with Vulkan allowed and
# denied, so this is a GL-path failure, not a Vulkan one.
# Patch 0027 injects io.flutter.embedding.android.EnableImpeller=false for these
# packages via PackageManagerService, forcing the Skia backend instead.
# No APK modification needed; Vulkan games remain untouched.
persist.sys.xdplus.flutter_disable_impeller=dev.imranr.obtainium,dev.bikram.obtainx

# HDMI output: mirror-first default. persist.sys.xdplus.hdmi_force_validate is
# read by SurfaceFlinger once at startup; 0 lets the vendor composer enter its
# DECOUPLE_MIRROR path, 1 forces the external display onto CLIENT composition
# (the extension-mode path that leaves the built-in panel frozen). The Settings
# toggle still allows flipping to extension mode, but it takes a reboot.
persist.sys.xdplus.hdmi_force_validate=0

# Mirror pacing: stop the composer from pacing external frames on vsync. The
# default vsync-paced path produced a visibly stuttery mirror; disabling it is
# now the default. The Settings toggle can re-enable it for A/B testing.
persist.sys.xdplus.hdmi_novsync=1
