# Types for the two file objects this port owns outright.

# The mini-HDMI debugfs node, labelled in genfs_contexts. debugfs_type carries
# the platform's debugfs neverallows (no executables there, and so on) while
# keeping it out of the blanket generic-debugfs ban.
type xdplus_debugfs_hdmi, fs_type, debugfs_type;

# The denial log xdplus_avcd writes and xdplus_tweaks exports. It needs a type
# of its own: /data/misc defaults to system_data_file, which domain.te
# neverallows any new domain from writing.
type xdplus_data_file, file_type, data_file_type, core_data_file_type;

# ⚠️ There is deliberately no type for a shared shader-cache directory, because
# there is no shared directory any more.
#
# vkshim used to write every cache into one sticky /data/vkshim. That cannot
# work under enforcement from either side: app_neverallows.te forbids untrusted
# apps from `create`/`unlink` on any type outside the per-app sandbox set (so a
# custom type fails the build), and domain.te neverallows a new domain from
# writing or unlinking system_data_file (so the root-side budget prune fails
# too). The shim now writes into the calling app's own sandbox, where
# app_data_file access already exists and needs no rule at all.
