#!/system/bin/sh
# xdplus_tweaks — privileged dispatcher for the in-Settings "GPD XD+" menu.
# Runs as root from init.xdplus.rc triggers. The Settings menu only sets the
# sys.xdplus.*/persist.sys.xdplus.* props; all root-side work happens here.
#
# Usage: xdplus_tweaks [command]   (no command = read sys.xdplus.action)
#   hdmi_up      mini-HDMI DECOUPLE_MIRROR bringup
#   hdmi_down    tear HDMI down, return to built-in panel only
#   boot         re-apply persisted toggles at boot_completed, prune the cache dir
#   vkcache_prune  retired: caches live in each app's own sandbox now
#   vkcache_clear  delete every shader cache (root-only work)

H=/d/hdmi
# hdmictl now ships in the image (device/gpd/xdplus/hdmi); the /data copy is only
# a fallback for devices flashed before that landed.
CTL=/system/bin/hdmictl
[ -x "$CTL" ] || CTL=/data/local/tmp/hdmictl
# The acqfd-patched HWC blob lives in the VENDOR PARTITION — no bind
# mount, no composer restart, survives reboots. BLOB is only the legacy fallback.
BLOB=/data/local/tmp/hwcomposer.patched.so
VBLOB=/system/vendor/lib64/hw/hwcomposer.mt8173.so
VBLOB_MD5=54b28199

# NOTE: never name this function 'log' — a same-named function shadows the /system/bin/log
# binary and recurses infinitely, hanging the service. Use the binary by full path.
xlog() { /system/bin/log -t xdplus_tweaks "$*" 2>/dev/null; echo "xdplus_tweaks: $*"; }

# DECOUPLE_MIRROR bringup. The panel stays on hardware overlays
# (OVL0 -> WDMA0 -> RDMA0) and the external display is fed by the MDP blit — no
# GPU composition on either pipe. Replaces the old 1008-latch path,
# which forced the external display onto GPU CLIENT composition and left the
# panel frozen while mirroring.
#
# On kernels with the survive-blank fix, the mirror path is kept alive through
# a device screen-off/screen-on cycle; on older kernels the path is torn down
# by the blank and must be brought up again afterwards.
#
# Preconditions, all discovered the hard way:
#  - persist.sys.xdplus.hdmi_force_validate must have been 0 AT BOOT.
#    SurfaceFlinger reads it once at startup; the forced validate makes the
#    external display CLIENT-composed with a single layer, the blob's
#    isMirrorList then fails (chkMir L3819), and no live prop write can fix it.
#  - debug.hwc.mirror_state must be 1 BEFORE display 1 hotplugs: the mirror
#    output queue is only created in HWCDispatcher::onPlugIn.
#  - The keyguard must be dismissed: its KEYGUARD_DIALOG presentation on the
#    external display makes WindowManager report the display as having content,
#    DisplayManager then gives it its own layer stack instead of mirroring
#    stack 0, and the blob refuses (I-size mismatch at chkMir L3819).
# Poll a condition instead of sleeping through it. $1 is the old sleep's length
# and becomes the timeout, so the worst case is unchanged and the typical case is
# as fast as the hardware allows; returns 0 the moment the condition holds, 1 on
# timeout. Callers that used to sleep unconditionally must still work when this
# returns 1 -- a timeout has to mean "carry on and let the existing check decide",
# never "fail", or an unreliable probe would turn a working bringup into a failed
# one. Measured before this existed: bringup spent 5.06 s between the plug uevent
# and powering the transmitter, and another 5.09 s reaching DECOUPLE_MIRROR, all
# of it waiting on timers rather than on the hardware.
wait_for() {
	_wf_left=$(( $1 * 5 ))
	while [ "$_wf_left" -gt 0 ]; do
		eval "$2" && return 0
		sleep 0.2
		_wf_left=$(( _wf_left - 1 ))
	done
	return 1
}

hdmi_up() {
	RES="$(getprop persist.sys.xdplus.hdmi_res)"; [ -z "$RES" ] && RES=2
	if [ ! -x "$CTL" ]; then
		xlog "hdmictl missing ($CTL) — image too old, stage it in /data/local/tmp"
		return 1
	fi
	# The patched blob is expected to be part of /vendor already. Only fall back to
	# the old bind-mount + composer restart (~40 s framework bounce) if it is not.
	if ! md5sum "$VBLOB" | grep -q "$VBLOB_MD5"; then
		if [ -f "$BLOB" ]; then
			mount -o bind "$BLOB" "$VBLOB" && \
				kill "$(pidof android.hardware.graphics.composer@2.1-service)"
			xlog "unpatched vendor blob — bind-mounted + composer restarted, rerun after the bounce"
			return 0
		fi
		xlog "unpatched vendor blob and no $BLOB to fall back on — aborting"
		return 1
	fi

	if [ "$(getprop persist.sys.xdplus.hdmi_force_validate)" != "0" ]; then
		xlog "mirror mode not armed (hdmi_force_validate != 0 at boot) — enable 'HDMI mirror mode' in the GPD XD+ menu and reboot first"
		return 1
	fi

	# Mirror queue gate + dispatcher pacing. Both are debug.hwc.* props the
	# blob only re-reads inside HWCMediator::deviceDump, so latch them with a
	# dumpsys BEFORE display 1 registers. trigger_by_vsync=0 is now the default
	# in mirror mode because vsync pacing made the external picture stutter.
	setprop debug.hwc.mirror_state 1
	if [ "$(getprop persist.sys.xdplus.hdmi_novsync)" != "0" ]; then
		setprop debug.hwc.trigger_by_vsync 0
		xlog "trigger_by_vsync=0 (default mirror pacing)"
	fi
	dumpsys SurfaceFlinger > /dev/null

	# Keyguard gate (see header). 224 = KEYCODE_WAKEUP. input and wm are
	# app_process launches costing about a second each, and on the path that
	# matters -- a cable already in at boot -- the device is awake and the
	# keyguard is not up, so both were pure cost. Read the state first (a
	# dumpsys is far cheaper) and only pay when there is something to change.
	if ! dumpsys power 2>/dev/null | grep -q "mWakefulness=Awake"; then
		input keyevent 224
		wait_for 1 'dumpsys power 2>/dev/null | grep -q "mWakefulness=Awake"'
	fi
	if dumpsys window 2>/dev/null | grep -q "isKeyguardShowing=true"; then
		wm dismiss-keyguard
		wait_for 2 '! dumpsys window 2>/dev/null | grep -q "isKeyguardShowing=true"'
	fi

	# NOTE: the debugfs nodes can come up 0444, which makes every write below fail
	# with "Permission denied" even as root.
	chmod 666 $H /d/dispsys 2>/dev/null

	xlog "kernel bringup (res=$RES)"
	# No 'disable' step: the kernel no longer presets is_enabled, so a
	# single enable runs hdmi_drv_init() and creates hdmi_rdma_config_kthread.
	# Both of these used to be blind sleeps for hardware settling, because
	# /d/hdmi_pwrpin's powerenable/clockenable are a trap: they flip when the
	# call returns, so they prove the call happened, not that the hardware
	# settled. Each now waits on something the driver only produces once the
	# step really finished, with the old sleep kept as the timeout:
	#  - enable runs hdmi_drv_init(), whose last act is to create the
	#    hdmi_rdma_config_kthread kernel thread (comm truncated to 15 chars).
	#  - power 1 powers the transmitter; the driver then detects the sink and
	#    reads its EDID on the powered path, and publishes ready=1 only after
	#    that, which is the point a mode set will stick. A kernel too old to
	#    publish ready= simply times out into the old 3 s wait.
	$CTL enable;  wait_for 2 'pgrep hdmi_rdma_confi >/dev/null 2>&1'
	$CTL power 1; wait_for 3 'grep -q "ready=1" /d/hdmi_pwrpin 2>/dev/null'
	$CTL res "$RES"
	wait_for 6 'dumpsys SurfaceFlinger 2>/dev/null | grep -q "DisplayDevice{1"'

	for try in 1 2 3; do
		if [ "$(dumpsys display | grep -c 'HDMI Screen')" = 0 ]; then
			# This res 11 -> res N toggle, and the retry loop around it, are a
			# workaround for a bringup that is not reliable -- nobody has found
			# why a single mode set sometimes does not register display 1. It
			# costs nothing on a healthy bringup because the check above skips
			# it, so it stays until there is evidence it is dead: the log line
			# below is that evidence being collected. The intermediate mode set
			# is waited for rather than slept through -- res_hdmi carries the
			# applied mode + 1, so 11 lands as 12.
			xlog "attempt $try: display 1 absent after the mode set — toggling via res 11"
			echo fakecablein:disable > $H
			$CTL res 11
			wait_for 3 '[ "$(cat /sys/class/switch/res_hdmi/state 2>/dev/null)" = 12 ]'
			$CTL res "$RES"
			wait_for 5 'dumpsys SurfaceFlinger 2>/dev/null | grep -q "DisplayDevice{1"'
		fi

		if [ "$(dumpsys SurfaceFlinger | grep -c 'DisplayDevice{1')" = 0 ]; then
			xlog "attempt $try: display 1 not registered — retrying"
			continue
		fi
		# Keyguard/presentation check: mirroring means the external display is on
		# the default layer stack. Its own stack = something (usually the keyguard
		# presentation) claimed it and the blob will refuse the mirror.
		if ! dumpsys SurfaceFlinger | grep -A3 'DisplayDevice{1' | grep -q 'layerStack=0'; then
			xlog "attempt $try: external display not mirroring stack 0 (keyguard?) — dismissing and retrying"
			wm dismiss-keyguard
			wait_for 2 '! dumpsys window 2>/dev/null | grep -q "isKeyguardShowing=true"'
			continue
		fi
		# Wait for the mode the check below wants rather than a fixed 2 s. A
		# timeout falls through deliberately: the existing read then reports
		# whatever the mode actually is, including the empty case it accepts.
		wait_for 2 'grep -q "session_mode:4" /d/mtkfb 2>/dev/null'
		# Session mode comes from the driver's own state, not from dmesg.
		# The old check parsed the kernel ring buffer, so anything that
		# cleared or flooded it made a HEALTHY mirror read as failed and
		# the teardown below then destroyed it. 4 = DECOUPLE_MIRROR.
		SMODE="$(sed -n 's/.*session_mode:\([0-9]*\).*/\1/p' /d/mtkfb 2>/dev/null | head -1)"
		if [ "$SMODE" = 4 ]; then
			xlog "HDMI mirror up (DECOUPLE_MIRROR, res=$RES)"
			anim_zero_apply
			return 0
		fi
		if [ -z "$SMODE" ]; then
			# Kernel too old to publish session_mode, or the node did not
			# read. Display 1 is registered and mirroring stack 0, so
			# accept it: tearing down on an inconclusive read is the very
			# failure this replaced.
			xlog "HDMI up, session mode unreadable — accepting (res=$RES)"
			return 0
		fi
		xlog "attempt $try: display 1 up but session mode is $SMODE, not DECOUPLE_MIRROR — retrying"
	done

	# All attempts missed. Tear down cleanly so the primary panel is not left wedged
	# (a failed bringup must degrade to "working panel, no HDMI", never a black screen).
	xlog "HDMI bringup FAILED after 3 attempts — safe teardown"
	# An earlier bring-up may have zeroed the scales; a teardown must hand them
	# back whether or not this attempt was the one that took them.
	anim_zero_restore
	echo fakecablein:disable > $H 2>/dev/null
	$CTL power 0 2>/dev/null
	$CTL disable 2>/dev/null
	setprop debug.hwc.mirror_state 4
	return 1
}

# Optional: zero the three animation scales while the mirror is up.
#
# A rotation animation carries intermediate angles, and a layer whose composed
# transform is not one of the eight HWC2 transforms comes back ROT_INVALID from
# Transform::getOrientation(). SurfaceFlinger then has to render it itself, and
# client composition on the primary is exactly what makes the vendor composer
# abandon the mirror -- both screens freeze until the composer is bounced. With
# the scales at 0 there is no intermediate transform and no such frame.
#
# ⚠️ All three must be zero: window_animation_scale alone leaves RotationLayer
# carrying ROT_INVALID and changes nothing (measured).
#
# Off by default. This costs the user their animations, so it is a choice, not
# a fix -- the launch-animation half of the same freeze is handled properly in
# SurfaceFlinger and needs none of this.
PROP_ZERO_ANIM=persist.sys.xdplus.hdmi_zero_anim
PROP_ANIM_SAVED=persist.sys.xdplus.anim_saved
ANIM_KEYS="window_animation_scale transition_animation_scale animator_duration_scale"

anim_get() {
	v=$(settings get global "$1" 2>/dev/null)
	# Unset reads back as the literal "null"; the framework default is 1.
	case "$v" in ''|null) echo 1 ;; *) echo "$v" ;; esac
}

anim_zero_apply() {
	[ "$(getprop $PROP_ZERO_ANIM)" = "true" ] || return 0
	# Save once only. A second bring-up must not capture the zeros we just wrote
	# and make them the values we "restore" on unplug.
	[ -z "$(getprop $PROP_ANIM_SAVED)" ] || return 0
	saved=
	for k in $ANIM_KEYS; do saved="$saved$(anim_get "$k") "; done
	setprop $PROP_ANIM_SAVED "${saved% }"
	for k in $ANIM_KEYS; do settings put global "$k" 0 2>/dev/null; done
	xlog "animation scales zeroed for the mirror (saved: ${saved% })"
}

anim_zero_restore() {
	saved=$(getprop $PROP_ANIM_SAVED)
	[ -n "$saved" ] || return 0
	set -- $saved
	for k in $ANIM_KEYS; do
		[ -n "$1" ] && settings put global "$k" "$1" 2>/dev/null
		shift
	done
	setprop $PROP_ANIM_SAVED ""
	xlog "animation scales restored ($saved)"
}

hdmi_down() {
	anim_zero_restore
	[ -x "$CTL" ] && { $CTL power 0; $CTL disable; }
	# Park the mirror queue gate so the next plain hotplug does not create the
	# mirror output queue against a torn-down path.
	setprop debug.hwc.mirror_state 4
	xlog "HDMI torn down"
}

# hdmi_up/hdmi_down are also driven automatically on cable plug/unplug, by
# /system/bin/xdplus_hdmid. That daemon sleeps on the kernel uevent netlink
# socket rather than polling this state, deliberately: a shell watcher reading
# /sys/class/switch/hdmi/state on a timer costs a wakeup per interval for the
# whole uptime, which is not affordable against a 0.338 %/h standby floor.
# poll() on the sysfs attribute is not an alternative either -- the switch
# class calls kobject_uevent_env() and never sysfs_notify(), so the attribute
# never wakes a poller. Both entry points remain callable by hand.

# Relay a vkshim compile-progress update (sys.xdplus.vkcompile = "<pkg>:<count>")
# to the Settings receiver. Reads the prop live rather than taking an argument so
# rapid updates coalesce to the newest value. Explicit-component broadcast from
# root reaches the non-exported receiver.
vknotify() {
	MODE="$(getprop persist.sys.xdplus.vknotify)"
	[ -z "$MODE" ] && MODE=notification
	[ "$MODE" = "off" ] && return 0
	V="$(getprop sys.xdplus.vkcompile)"
	[ -z "$V" ] && return 0
	PKG="${V%%:*}"
	CNT="${V##*:}"
	am broadcast -n org.lineageos.settings.xdplus/.VkCompileReceiver \
		--es pkg "$PKG" --es count "$CNT" --es mode "$MODE" >/dev/null 2>&1
}

# Shader caches live in each app's own sandbox now
# (/data/user/<user>/<pkg>/cache/vkshim.pcache), so there is no shared directory
# left to hold under a budget: each cache is counted against its own app's
# storage and is removed with that app's data like any other cache file.
#
# The shared /data/vkshim could not survive SELinux enforcement in either
# direction -- an app may not create or unlink files outside its sandbox types,
# and a root daemon may not write or unlink system_data_file -- so both the
# shim's writes and this prune would have been denied.
vkcache_prune() {
	xlog "vkcache_prune is retired: caches are per-app now, nothing to prune"
}

# Caches live inside app sandboxes now, and root cannot delete them there:
# domain.te neverallows every domain but appdomain and installd from unlinking
# app_data_file. So the clear is a handshake instead -- bump a generation
# property, and each app's own shim drops its cache the next time it starts.
#
# That matches the old behaviour anyway: an app held its cache open until it
# exited, so a delete only ever took effect on the next launch.
vkcache_clear() {
	GEN="$(getprop persist.sys.xdplus.vkcachegen)"
	case "$GEN" in ''|*[!0-9]*) GEN=0 ;; esac
	GEN=$((GEN + 1))
	setprop persist.sys.xdplus.vkcachegen "$GEN"
	xlog "shader caches marked stale (generation $GEN); each app clears its own on next start"
}

# No argument means "read the dispatch property yourself".
#
# The dispatcher service used to pass ${sys.xdplus.action} on its command line.
# init expands that when it PARSES the rc file, and the property is unset then,
# so the service definition was dropped: `init.svc.xdplus-tweaks` did not exist
# at all and every momentary menu action was a no-op. Reading the property here
# is what makes the trigger work; the fixed-argument services (boot, vknotify)
# still pass theirs literally.
CMD="$1"
[ -n "$CMD" ] || CMD="$(getprop sys.xdplus.action)"

# Retired toggles: clear properties whose Settings entry no longer exists.
#
# Removing a toggle from the menu does NOT clear what it already wrote. A
# `persist.` value set by an older build survives the flash and stays set
# forever, so a device that once had a toggle keeps behaving as if it were on
# while the UI shows nothing — invisible state that silently invalidates any
# later A/B. Clearing is one-way and cheap: nothing reads these any more.
#
#  hdmi_unfreeze   KNOWN-BAD (debug.hwc.is_skip_validate). It unfreezes nothing
#                  and makes a freeze sticky across teardown, a composer restart
#                  and a full reboot. Shipped default-on once; must not linger.
#  wifi_standard_11n_fallback  the PHY-mode label fix is unconditional now.
#  vkcachedirmax   the whole-directory budget is gone with the shared cache
#                  directory; each cache is per-app and capped by the shim's
#                  own persist.sys.xdplus.vkcachemax.
#
# ⚠️ Append to this list whenever a toggle is retired; do not repurpose a name.
prune_retired_props() {
	for p in \
		persist.sys.xdplus.hdmi_unfreeze \
		persist.sys.wifi_standard_11n_fallback \
		persist.sys.xdplus.vkcachedirmax
	do
		if [ -n "$(getprop $p)" ]; then
			xlog "clearing retired property $p"
			setprop "$p" ""
		fi
	done
}

# Guard: the SurfaceFlinger-poking paths must never run before the framework is
# fully up. init also gates the triggers on sys.boot_completed, but a manual/
# early invocation must be a no-op too.
if [ "$CMD" != "hdmi_down" ] && [ "$(getprop sys.boot_completed)" != "1" ]; then
	xlog "boot not completed — deferring '$CMD'"
	setprop sys.xdplus.action none
	exit 0
fi

case "$CMD" in
	hdmi_up)   hdmi_up ;;
	hdmi_down) hdmi_down ;;
	# Boot path: hold the shader-cache directory under budget — the one place
	# that can, now that the directory is sticky — and retire properties whose
	# toggles no longer exist.
	# A reboot while the mirror was up leaves the saved scales stranded in a
	# persist property, so the user would come back to a device with no
	# animations and nothing on screen explaining why. Hand them back at boot.
	boot)      anim_zero_restore; prune_retired_props; vkcache_prune ;;
	vkcache_prune) vkcache_prune ;;
	vkcache_clear) vkcache_clear ;;
	# Compile-progress relay: exits quietly, and must NOT clear sys.xdplus.action
	# (it never set it).
	vknotify)  vknotify; exit 0 ;;
	*)         xlog "unknown command: $CMD"; exit 1 ;;
esac
setprop sys.xdplus.action none
