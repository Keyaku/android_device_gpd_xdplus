# xdplus system-side init additions.

# Seed /data/misc/wifi/{wpa,p2p}_supplicant.conf on a fresh /data. This port's
# init only creates the dir; nothing recreates the templates wpa_supplicant is
# launched with, so a factory reset otherwise leaves Wi-Fi permanently unable to
# start supplicant (PORTING_LOG §33). Copy-if-missing, root, once, at post-fs-data.
service xdplus-wifiseed /system/bin/sh /system/etc/xdplus_wifi_seed.sh
    class main
    user root
    group wifi system
    disabled
    oneshot

# Re-enable Wi-Fi after a HAL SelfRecovery disable (see xdplus_wifi_selfheal.sh).
# Runs as root: needs `settings` + `cmd` (system context), SELinux permissive.
service xdplus-wifi-selfheal /system/bin/sh /system/etc/xdplus_wifi_selfheal.sh
    class main
    user root
    group system wifi
    disabled
    oneshot

on post-fs-data
    start xdplus-wifiseed

# Driver power-save causes the AP to low-ack-kick the device under sustained
# transfer load (PORTING_LOG §44/§49) — `iw dev wlan0 set power_save off`
# proved necessary live. The real fix is patch 0012 (+
# persist.sys.wifi_ps_pin_off in system.prop): the framework re-enables
# power-save through ClientModeImpl.setPowerSave after every DHCP, so any
# one-shot write gets overridden. This trigger only covers the raw driver
# default in the window between driver (re)load and the framework's first
# setPowerSave — the MTK wmt stack reloads the driver on every Wi-Fi toggle,
# and wpa_supplicant (re)start marks exactly that moment with wlan0 present.
on property:init.svc.wpa_supplicant=running
    exec - root wifi -- /system/bin/iw dev wlan0 set power_save off

# The prebuilt 8.1 vendor configstore service SIGSYS-crashes on its stale
# seccomp policy. Worse than the crash-loop: it briefly registers configstore
# @1.0 ISurfaceFlingerConfigs, clobbering the @1.0 chain entry the system
# configstore-hal-system (@1.1 xdplus service) already registered — and when
# the vendor process dies (crash, or the old stop-on-running hack here), the
# @1.0 registration dies with it, so SurfaceFlinger spins ~30s in getService()
# until a lazy-start kick makes the xdplus service exit/restart and re-register
# the chain. The only safe state is: vendor copy NEVER runs. Override its
# definition with a disabled one (same pattern as mediacodec below); system rc
# parses before vendor rc, so the vendor duplicate is dropped.
service configstore-hal-1-0 /vendor/bin/hw/android.hardware.configstore@1.0-service
    class hal animation
    user system
    group system
    disabled
    override

# Belt-and-suspenders: if it ever does get started (ctl.start, interface_start),
# put it back down before it can clobber the @1.0 registration for long.
on property:init.svc.configstore-hal-1-0=running
    stop configstore-hal-1-0

# The vendor omx service (O-era binary) can no longer link against the R
# libstagefright (missing MediaCodecsXmlParser::defaultSearchDirs) and would
# crash-loop every 5s all boot; media works via the system omx-hal-system,
# which owns IOmx/IOmxStore. Override the vendor 'mediacodec' definition with
# a disabled one so init never launches it (system rc parses before vendor rc,
# so the vendor duplicate is dropped; 'override' covers the reverse order too).
# The boot_completed 'stop mediacodec' below stays as a fallback.
service mediacodec /vendor/bin/hw/android.hardware.media.omx@1.0-service
    class main
    user mediacodec
    group camera drmrpc mediadrm
    disabled
    override

on property:sys.boot_completed=1
    stop configstore-hal-1-0
    # vendor omx service is unlinkable (O-era ABI); system omx-hal-system replaces it
    stop mediacodec
    # Re-enable Wi-Fi if the HAL SelfRecovery throttled it off at early boot
    # (see xdplus_wifi_selfheal.sh — only acts when the user setting is "on"
    # but supplicant is stopped; otherwise a no-op).
    start xdplus-wifi-selfheal
    # MT8173 boots on the kernel-default 'ondemand' governor: no input boost and
    # go_hispeed_load=99 (won't ramp until ~saturated) => the felt input latency.
    # Switch both clusters to interactive and lower the ramp thresholds. Done at
    # boot_completed so it lands after the MTK power HAL, which would otherwise
    # clobber an earlier write. Tunable nodes only exist once interactive is set,
    # so set the governor first, then the tunables, in order.
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/go_hispeed_load 85
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/target_loads 80
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/min_sample_time 40000
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/go_hispeed_load 85
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/target_loads 80
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/min_sample_time 40000

# Vendor HAL services started from the 8.1 vendor rc can lose the boot race
# against hwservicemanager: the process stays alive but its interface never
# registers, and (VINTF unenforced) clients block forever in getService().
# Seen with configstore (replaced above) and light@2.0 (system_server thread
# hung on ILight). Kick the known victims once the manager is ready.
on property:hwservicemanager.ready=true
    restart light-hal-2-0
