# xdplus system-side init additions.

# --- Disable MTK hotplug (hps) before it can run, not after --------------------
# /vendor/etc/init/hw/init.mt8173.rc already disables hps and forces all six cores
# online, with the comment "it causes noticeable stutters" — but under `on boot`,
# long after the damage. hps takes CPU5 and CPU4 offline ~3 ms apart at 7.9-9.1 s,
# roughly 80 ms BEFORE zygote starts. Taking the last big core offline tears down
# the A72 cluster's cpufreq policy, and it is never re-registered:
# /sys/devices/system/cpu/cpu4/cpufreq/ does not exist for the rest of that boot
# even though `online` still reads 0-5. The A72s then run unscaled at their boot
# OPP and cpu0 sits pegged at 1703 MHz carrying the whole machine alone — that is
# the entire 24-40 s "identical image boots at different speeds" spread.
#
# `on init` is the earliest trigger that runs after the kernel's procfs exists
# (hps registers its proc entries from a device_initcall, well before init), and
# it is ~5 s ahead of the first hps down-migration. Writing a path that does not
# exist is a logged no-op, so this is safe if the driver is ever compiled out.
#
# NOTE this does not fix the underlying kernel bug — the big cluster's cpufreq
# policy still fails to come back after a full-cluster offline during boot. It
# stops the only thing that triggers it. A runtime offline/online cycle of CPU4+5
# after boot restores the policy correctly, so the re-registration failure is a
# boot-window race, not a general hotplug defect.
on init
    write /proc/hps/enabled "0"
    write /sys/devices/system/cpu/cpu0/online "1"
    write /sys/devices/system/cpu/cpu1/online "1"
    write /sys/devices/system/cpu/cpu2/online "1"
    write /sys/devices/system/cpu/cpu3/online "1"
    write /sys/devices/system/cpu/cpu4/online "1"
    write /sys/devices/system/cpu/cpu5/online "1"

# --- GPD XD+ tweaks menu dispatch (Settings > GPD XD+) -----------------------
# The in-Settings menu sets sys.xdplus.*/persist.sys.xdplus.* props; these
# triggers run the root-side dispatcher. See rootdir/system/bin/xdplus_tweaks.
#
# The dispatcher is exec'd directly, NOT as `/system/bin/sh <script>`: init's
# exec target has to be the script itself, or every one of these services runs
# as u:r:init:s0 and is denied execute_no_trans the moment SELinux enforces.
# rootdir/Android.mk installs it 0755 with its own exec label for that reason.
service xdplus-tweaks /system/bin/xdplus_tweaks
    class main
    user root
    group root system graphics input
    disabled
    oneshot

# Momentary action dispatch. The menu only ever sets these post-boot, so the
# script (which pokes SurfaceFlinger) is always safe here. hdmi_up/hdmi_down
# route through the single dispatcher service, which reads sys.xdplus.action
# itself. It used to take ${sys.xdplus.action} as a command-line argument, but
# init expands that once when it PARSES this file, with the property unset, so
# every dispatch ran with an empty command and did nothing.
on property:sys.xdplus.action=hdmi_up
    start xdplus-tweaks

on property:sys.xdplus.action=hdmi_down
    start xdplus-tweaks

# SELinux denial recorder. Opt-in: it holds a dmesg reader open all boot.
service xdplus-avcd /system/bin/xdplus_avcd
    class late_start
    user root
    group root system log
    disabled

on property:persist.sys.xdplus.avclog=1
    start xdplus-avcd

on property:persist.sys.xdplus.avclog=0
    stop xdplus-avcd

on property:sys.xdplus.action=selinux
    start xdplus-tweaks

on property:sys.xdplus.action=avclog_clear
    start xdplus-tweaks

on property:sys.xdplus.action=vkcache_clear
    start xdplus-tweaks

# --- Vulkan shader-compile progress relay ------------------------------------
# vkshim (system/lib{,64}/vulkan.mt8173.so) publishes "<pkg>:<count>" on
# sys.xdplus.vkcompile while a slow pipeline compile runs; relay each update to
# the Settings VkCompileReceiver, which shows a notification or toast per
# persist.sys.xdplus.vknotify. The service re-reads the prop itself, so updates
# arriving while a relay is still running are coalesced, not queued.
service xdplus-vknotify /system/bin/xdplus_tweaks vknotify
    class main
    user root
    group root system
    disabled
    oneshot

on property:sys.xdplus.vkcompile=*
    start xdplus-vknotify

# vkshim's pipeline caches live inside each app's own sandbox now
# (/data/user/<user>/<pkg>/cache/vkshim.pcache), so this port creates no shared
# cache directory. The old sticky /data/vkshim could not work under SELinux
# enforcement: an app may not create or unlink files outside its sandbox types,
# and the root daemon that held it under a budget may not write system_data_file.
# ⚠️ A device upgraded from a build that had it keeps a stale /data/vkshim; it
# is dead weight, not a hazard, and nothing recreates it.

# Re-apply persisted toggles once the framework is up.
service xdplus-tweaks-boot /system/bin/xdplus_tweaks boot
    class main
    user root
    group root system graphics
    disabled
    oneshot

on property:sys.boot_completed=1
    start xdplus-tweaks-boot

# Seed /data/misc/wifi/{wpa,p2p}_supplicant.conf on a fresh /data. This port's
# init only creates the dir; nothing recreates the templates wpa_supplicant is
# launched with, so a factory reset otherwise leaves Wi-Fi permanently unable to
# start supplicant. Copy-if-missing, root, once, at post-fs-data.
# Holds one 1x1 layer while a second display is attached: the composer mirrors only
# while both displays' visible-layer lists match, and an app whose list collapses to a
# single layer drops the mirror. Self-gating on persist.sys.xdplus.mirror_pin, so the
# Settings toggle needs no dispatch here.
service xdplus-mirrorpin /system/bin/xdplus_pinlayer --service
    class main
    user system
    group graphics system
    disabled

on property:sys.boot_completed=1
    start xdplus-mirrorpin

service xdplus-wifiseed /system/bin/xdplus_wifi_seed
    class main
    user root
    group wifi system
    disabled
    oneshot

on post-fs-data
    start xdplus-wifiseed

# Driver power-save causes the AP to low-ack-kick the device under sustained
# transfer load — `iw dev wlan0 set power_save off`
# proved necessary live. The real fix is patch 0011 (+
# persist.sys.wifi_ps_pin_off in system.prop): the framework re-enables
# power-save through ClientModeImpl.setPowerSave after every DHCP, so any
# one-shot write gets overridden. This trigger only covers the raw driver
# default in the window between driver (re)load and the framework's first
# setPowerSave — the MTK wmt stack reloads the driver on every Wi-Fi toggle,
# and wpa_supplicant (re)start marks exactly that moment with wlan0 present.
on property:init.svc.wpa_supplicant=running
    exec - root wifi -- /system/bin/iw dev wlan0 set power_save off

# The prebuilt 8.1 vendor configstore service SIGSYS-crashes on its stale
# seccomp policy. Worse than the crash-loop: it briefly registers configstore
# @1.0 ISurfaceFlingerConfigs, clobbering the @1.0 chain entry the system
# configstore-hal-system (@1.1 xdplus service) already registered — and when
# the vendor process dies (crash, or the old stop-on-running hack here), the
# @1.0 registration dies with it, so SurfaceFlinger spins ~30s in getService()
# until a lazy-start kick makes the xdplus service exit/restart and re-register
# the chain. The only safe state is: vendor copy NEVER runs. Override its
# definition with a disabled one (same pattern as mediacodec below); system rc
# parses before vendor rc, so the vendor duplicate is dropped.
service configstore-hal-1-0 /vendor/bin/hw/android.hardware.configstore@1.0-service
    class hal animation
    user system
    group system
    disabled
    override

# Belt-and-suspenders: if it ever does get started (ctl.start, interface_start),
# put it back down before it can clobber the @1.0 registration for long.
on property:init.svc.configstore-hal-1-0=running
    stop configstore-hal-1-0

# The vendor omx service (O-era binary) can no longer link against the R
# libstagefright (missing MediaCodecsXmlParser::defaultSearchDirs) and would
# crash-loop every 5s all boot; media works via the system omx-hal-system,
# which owns IOmx/IOmxStore. Override the vendor 'mediacodec' definition with
# a disabled one so init never launches it (system rc parses before vendor rc,
# so the vendor duplicate is dropped; 'override' covers the reverse order too).
# The boot_completed 'stop mediacodec' below stays as a fallback.
service mediacodec /vendor/bin/hw/android.hardware.media.omx@1.0-service
    class main
    user mediacodec
    group camera drmrpc mediadrm
    disabled
    override

# --- cpuset masks per group --------------------------------------------------
# AOSP's system/core/rootdir/init.rc creates the cpuset groups and copies the
# ROOT mask into every one of them, with the comment "the device's init.rc must
# actually set the correct cpus". This device never did, so top-app, foreground,
# background, system-background and restricted were all `0-5` and placement
# differentiated nothing.
#
# Topology: cpu0-3 = A53 @1.70 GHz (little), cpu4-5 = A72 @2.11 GHz (big).
# Background work goes to the A53s so it cannot displace foreground work on the
# big cores; top-app and foreground keep both clusters.
#
# This only became meaningful once the cpuset controller gained its allow_attach
# hook (kernel 325922b6) — before that every non-root placement failed -EACCES,
# 803 per boot, so no mask could have had any effect.
#
# post-fs-data, not init: the groups are created by core init.rc under `on init`
# and this must land after them, while still being long before ActivityManager
# places anything.
on post-fs-data
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/restricted/cpus 0-3

# --- Early governor switch ---------------------------------------------------
# The kernel default is already 'interactive' (CONFIG_CPU_FREQ_DEFAULT_GOV_
# INTERACTIVE in mt8176_defconfig), but the vendor rc overwrites both clusters
# with 'ondemand' inside its own `on boot` block ("swap to ondemand governor (as
# it works better)"). That covers the whole heavy phase — zygote preload, PMS,
# system_server — during which ondemand's go_hispeed_load=99 will not ramp until
# the CPU is nearly saturated. Nothing in /vendor writes scaling_governor from
# native code (checked: no blob references the node), so the vendor rc is the
# only writer to beat, and beating it is purely an ordering problem.
#
# Ordering: actions sharing a trigger run in parse order and the system rc is
# parsed BEFORE the vendor rc, so our own `on boot` block would lose. Setting a
# property instead queues its trigger after everything already queued for `on
# boot`, including the vendor write — deterministic, no timing guess. The
# boot_completed write below stays as-is: it is the backstop if anything else
# takes the node later in boot, and it re-applies the tunables regardless.
on boot
    setprop sys.xdplus.gov ready

on property:sys.xdplus.gov=ready
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/go_hispeed_load 85
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/target_loads 80
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/min_sample_time 40000
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/go_hispeed_load 85
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/target_loads 80
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/min_sample_time 40000

on property:sys.boot_completed=1
    stop configstore-hal-1-0
    # vendor omx service is unlinkable (O-era ABI); system omx-hal-system replaces it
    stop mediacodec
    # Re-apply the interactive switch (see the early block above). Kept because
    # this is the point past which nothing else writes the node, and because the
    # tunable nodes only exist once the governor is set — so governor first,
    # then tunables, in order.
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/go_hispeed_load 85
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/target_loads 80
    write /sys/devices/system/cpu/cpu0/cpufreq/interactive/min_sample_time 40000
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/go_hispeed_load 85
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/target_loads 80
    write /sys/devices/system/cpu/cpu4/cpufreq/interactive/min_sample_time 40000

# Vendor HAL services started from the 8.1 vendor rc can lose the boot race
# against hwservicemanager: the process stays alive but its interface never
# registers, and (VINTF unenforced) clients block forever in getService().
# Seen with configstore (replaced above) and light@2.0 (system_server thread
# hung on ILight). Kick the known victims once the manager is ready.
on property:hwservicemanager.ready=true
    restart light-hal-2-0
