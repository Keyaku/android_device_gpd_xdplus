// The reconstructed libgralloc_extra: MediaTek's per-buffer metadata sidecar,
// rebuilt from the shipping blob. Its consumers -- the composer, the OMX
// codecs, libgralloc_extra's other vendor callers -- stay blobs and link this
// by soname, so the module keeps the blob's name and ships on both ABIs.
//
// ⭐ It does NOT link libged. The four ged_ge_* entry points are ours, in
// src/ged.cpp, issued straight at /proc/ged using the bridge structures from
// our own kernel source. The only dependencies are AOSP's.
//
// Deliberately NOT in PRODUCT_PACKAGES, for the same reason as dpframework and
// hwcshim: /vendor is the frozen partition, and anything soong stages under
// out/.../system/vendor is shadowed at runtime by the partition mount. Build it
// with `mka libgralloc_extra.reconstruct` and let build_vendor_image.sh's
// BAKED_MODULES carry the result into the image.
//
// src/ is a copy. The canonical tree is tools/gralloc_extra_reconstruct/src,
// which carries the decompilation and the gates; sync_gralloc_extra.sh
// refreshes this copy and refuses to run backwards.
cc_library_shared {
	name: "libgralloc_extra.reconstruct",
	stem: "libgralloc_extra",
	proprietary: true,
	compile_multilib: "both",

	srcs: ["src/*.cpp"],
	local_include_dirs: ["src/include"],

	shared_libs: [
		"liblog",
		"libion",
	],

	cflags: [
		"-Wall",
		"-Werror",
		"-Wno-unused-parameter",
	],
}
