// dpconsumer_probe: the DpBlitStream overloads only libgpu_aux and
// libClearMotionFW import, which dpblit_sweep does not reach.
//
// Diagnostic only, never shipped and not in PRODUCT_PACKAGES. Built for both
// ABIs: ClearMotionFW ships 32-bit only, so the 32-bit run is the one that
// matches its real consumer. Run it under su -- the shell domain cannot reach
// /dev/mtk_cmdq.
//
// The canonical source is tools/dpconsumer_probe/dpconsumer_probe.c.
cc_binary {
	name: "dpconsumer_probe",
	compile_multilib: "both",
	multilib: {
		lib32: { suffix: "32" },
		lib64: { suffix: "64" },
	},

	srcs: ["dpconsumer_probe.c"],
	shared_libs: [
		"libdpframework.reconstruct",
		"libion",
		"libion_mtk",
		"liblog",
	],

	cflags: [
		"-Wall",
		"-Werror",
	],
}
