// Stub dumpstate HAL so getService(IDumpstateDevice) doesn't hang clients
// (no vendor impl exists). See service.cpp.
cc_binary {
	name: "android.hardware.dumpstate@1.1-service.xdplus",
	relative_install_path: "hw",
	init_rc: ["android.hardware.dumpstate@1.1-service.xdplus.rc"],
	srcs: ["service.cpp"],
	shared_libs: [
		"libhidlbase",
		"libbase",
		"liblog",
		"libutils",
		"android.hardware.dumpstate@1.0",
		"android.hardware.dumpstate@1.1",
	],
}
