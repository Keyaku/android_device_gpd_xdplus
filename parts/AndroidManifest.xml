<?xml version="1.0" encoding="utf-8"?>
<!--
  GPD XD+ device settings, shipped as an app in the device tree.

  This used to live inside a forked packages/apps/Settings, which put a
  "GPD XD+" entry on anything built from that fork whether the hardware was a
  GPD XD+ or not. The tile below is the supported alternative: Settings scans
  activities declaring com.android.settings.category at runtime and shows them
  on its home page, so the entry exists exactly where this app is installed and
  Settings itself is untouched.

  It runs as the system user with the platform certificate because every page
  writes sys.xdplus.* / persist.sys.xdplus.* properties, which the device
  SELinux policy grants to the system_app domain.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.xdplus"
    android:sharedUserId="android.uid.system">

    <application
        android:label="@string/gpd_xdplus_title"
        android:theme="@android:style/Theme.DeviceDefault.Settings">

        <activity
            android:name=".XdPlusPartsActivity"
            android:label="@string/gpd_xdplus_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/gpd_xdplus_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/gpd_xdplus_summary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_xdplus" />
        </activity>

        <!-- Explicit-component broadcast from the init-side dispatcher, which
             runs as root: vkshim's compile progress, relayed as a notification
             or a toast. -->
        <receiver
            android:name=".VkCompileReceiver"
            android:exported="true" />

    </application>
</manifest>
