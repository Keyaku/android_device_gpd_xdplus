<?xml version="1.0" encoding="utf-8"?>
<!-- GPD XD+ device tweaks menu. Kept in a device-specific file so the port's
     strings never collide with upstream Settings translation churn. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <string name="gpd_xdplus_title" translatable="false">GPD XD+</string>
    <string name="gpd_xdplus_summary" translatable="false">HDMI output, Vulkan shader cache, SELinux, crash dialogs</string>
    <string name="gpd_xdplus_cat_display" translatable="false">Display out</string>

    <string name="xdplus_hdmi_up_title" translatable="false">Bring up HDMI mirror</string>
    <string name="xdplus_hdmi_up_summary" translatable="false">Starts mirroring if plugging the cable in did not. Takes about 30 seconds, with the screen unlocked. If nothing appears, tear down and try once more.</string>
    <string name="xdplus_hdmi_up_toast" translatable="false">Bringing up HDMI mirror… (~30s)</string>
    <string name="xdplus_hdmi_down_title" translatable="false">Tear down HDMI</string>
    <string name="xdplus_hdmi_down_summary" translatable="false">Stops HDMI output and returns to the built-in screen. Also the way out if either picture freezes, or if the built-in screen comes back wrong.</string>
    <string name="xdplus_hdmi_down_toast" translatable="false">Tearing down HDMI…</string>

    <string name="xdplus_hdmi_pin_layer_title" translatable="false">Keep the monitor alive in fullscreen apps</string>
    <string name="xdplus_hdmi_pin_layer_summary" translatable="false">Holds one nearly invisible pixel on screen while a monitor is connected. Without it, games and other fullscreen apps freeze the monitor until you leave them. Takes effect within a few seconds. Leave it on unless you are testing.</string>

    <string name="xdplus_hdmi_res_title" translatable="false">HDMI resolution</string>
    <!-- %1$s is the chosen mode. The script reads the property when the mirror
         starts, so a change does not touch a running one. -->
    <string name="xdplus_hdmi_res_summary" translatable="false">%1$s — applies the next time the mirror starts</string>

    <!-- Non-selectable notes block at the top of the Display out page. Mirroring
         and its audio ship, so this states the rough edges that remain instead
         of calling the whole feature experimental. -->
    <string name="xdplus_hdmi_notes_title" translatable="false">Before you start</string>
    <string name="xdplus_hdmi_notes_summary" translatable="false">Mirroring works and carries sound. Plugging a monitor in usually starts it on its own; if nothing appears, use \"Bring up HDMI mirror\", and reboot if that fails twice. Two rough edges remain: opening an app after the console has sat idle can freeze both pictures, and an app that forces a portrait screen can leave the built-in one wrong. \"Tear down HDMI\" is the way out of both. Games also run less smoothly while a monitor is connected.</string>

    <string name="gpd_xdplus_cat_selinux" translatable="false">SELinux</string>
    <string name="gpd_xdplus_cat_selinux_summary" translatable="false">Enforcing mode, and exporting what it blocked</string>

    <string name="xdplus_selinux_enforce_title" translatable="false">Enforce SELinux</string>
    <!-- %1$s is the mode the device is running in right now. -->
    <string name="xdplus_selinux_enforce_summary" translatable="false">Currently %1$s. This build ships permissive: its policy is written but not finished, so enforcing can break things quietly — Wi-Fi and auto-rotate are the known ones. Applied at the next boot.</string>
    <string name="xdplus_selinux_enforcing" translatable="false">enforcing</string>
    <string name="xdplus_selinux_permissive" translatable="false">permissive</string>

    <string name="xdplus_selinux_avclog_title" translatable="false">Record denials</string>
    <string name="xdplus_selinux_avclog_summary" translatable="false">Keep a log of everything the policy denies, so it is still there after a reboot. Costs a background reader while it runs.</string>

    <string name="xdplus_selinux_export_title" translatable="false">Export denials to Download</string>
    <string name="xdplus_selinux_export_summary" translatable="false">Write every denial — recorded and still in the kernel buffer — to Download/xdplus-selinux-denials.log. Overwrites the previous export.</string>
    <string name="xdplus_selinux_export_toast" translatable="false">Exporting to Download/xdplus-selinux-denials.log</string>

    <string name="xdplus_selinux_clear_title" translatable="false">Clear recorded denials</string>
    <string name="xdplus_selinux_clear_summary" translatable="false">Empty the log, so the next thing you try starts from a clean list.</string>
    <string name="xdplus_selinux_clear_toast" translatable="false">Denial log cleared</string>

    <!-- %1$s is "source → target", %2$d how many times it was recorded. -->

    <string name="xdplus_hide_error_dialogs_title" translatable="false">Hide app crash dialogs</string>
    <string name="xdplus_hide_error_dialogs_summary" translatable="false">Suppress \"app has stopped\" popups (useful for kiosk / handheld use).</string>

    <string name="xdplus_vknotify_title" translatable="false">Shader compile notification</string>
    <string name="xdplus_vkcompile_channel" translatable="false">Vulkan shader compilation</string>
    <string name="xdplus_vkcompile_title" translatable="false">Compiling Vulkan shaders…</string>
    <string name="xdplus_vkcompile_text" translatable="false">%1$s — %2$s pipelines done. First run per game is slow; later runs use the cache.</string>

    <string-array name="xdplus_vknotify_entries" translatable="false">
        <item>Notification with progress</item>
        <item>Toast popups</item>
        <item>Off</item>
    </string-array>
    <string-array name="xdplus_vknotify_values" translatable="false">
        <item>notification</item>
        <item>toast</item>
        <item>off</item>
    </string-array>

    <!-- Landing-page summaries: say what is behind each entry, since the page
         is now three doors rather than three headings. -->
    <string name="gpd_xdplus_cat_display_summary" translatable="false">mini-HDMI output: start and stop, resolution, behaviour in fullscreen apps</string>
    <string name="gpd_xdplus_cat_shadercache_summary" translatable="false">Storage used by compiled game shaders, and how much to allow</string>

    <string name="gpd_xdplus_cat_shadercache" translatable="false">Vulkan shader cache</string>

    <string name="xdplus_vkcachemax_title" translatable="false">Shader cache limit per app</string>
    <string name="xdplus_vkcache_clear_title" translatable="false">Clear shader cache</string>
    <string name="xdplus_vkcache_clear_summary" translatable="false">Clear every cached shader. Each game clears its own the next time you start it, then recompiles its shaders once — slow that one time, fast again afterwards.</string>
    <string name="xdplus_vkcache_clear_toast" translatable="false">Shader caches will clear the next time each game starts</string>
    <!-- %1$s is the chosen limit. There is deliberately no "in use" figure:
         each cache lives inside its own app's sandbox now, which Settings
         cannot read. -->
    <string name="xdplus_vkcache_summary" translatable="false">%1$s — applies the next time a game starts</string>

    <!-- A shader cache trades storage for load time: shaders in it are not
         recompiled. It only ever grows (the driver blob gives no way to evict a
         single entry), so it is capped and frozen once full rather than reset,
         which would throw away every shader at once. -->
    <string-array name="xdplus_vkcache_entries" translatable="false">
        <item>32 MB</item>
        <item>64 MB (Recommended)</item>
        <item>128 MB</item>
        <item>256 MB</item>
    </string-array>
    <string-array name="xdplus_vkcache_values" translatable="false">
        <item>32</item>
        <item>64</item>
        <item>128</item>
        <item>256</item>
    </string-array>

    <!-- Sorted high -> low. 720p60 is the only latch-stable mode, so it carries
         the Recommended tag. Values: 1=1080, 2=720, 0=480. -->
    <string-array name="xdplus_hdmi_res_entries" translatable="false">
        <item>1080p60</item>
        <item>720p60 (Recommended)</item>
        <item>480p60</item>
    </string-array>
    <string-array name="xdplus_hdmi_res_values" translatable="false">
        <item>1</item>
        <item>2</item>
        <item>0</item>
    </string-array>

</resources>
