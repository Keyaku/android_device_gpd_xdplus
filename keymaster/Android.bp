// System_ext software keymaster@4.1 + gatekeeper@1.0 services. The prebuilt 8.1
// vendor's keymaster@3.0/gatekeeper HALs can't load (keymaster@3.0-impl needs an
// O-era SoftKeymasterContext symbol nothing in R provides; gatekeeper needs the
// absent libtz_uree.so). Without a working keystore, system_server NPEs all over
// (TrustManager, LockdownVpnTracker, ...). These AOSP software impls run on the
// framework side and let keystore/gatekeeperd come up. Sources copied verbatim
// from hardware/interfaces/{keymaster/4.1/default,gatekeeper/1.0/software}.

cc_binary {
	name: "android.hardware.keymaster@4.1-service.xdplus",
	stem: "android.hardware.keymaster@4.1-service.xdplus",
	defaults: ["hidl_defaults"],
	system_ext_specific: true,
	relative_install_path: "hw",
	init_rc: ["km41.rc"],
	vintf_fragments: ["km41.xml"],
	srcs: ["km_service.cpp"],
	shared_libs: [
		"android.hardware.keymaster@4.0",
		"android.hardware.keymaster@4.1",
		"libbase",
		"libcutils",
		"libhardware",
		"libhidlbase",
		"libkeymaster4",
		"libkeymaster41",
		"libkeymaster4_1support",
		"liblog",
		"libutils",
	],
}

// Binderized keymaster@3.0 service backed by the MT8173 TEE. Passthrough-loads
// the vendor android.hardware.keymaster@3.0-impl.so (now loadable — libtz_uree.so
// restored, PORTING_LOG §29) which wraps the trustlet HAL keystore.mt8173.so.
// keystore's support::Keymaster3 adapter presents it as a 4.x TRUSTED_ENVIRONMENT.
cc_binary {
	name: "android.hardware.keymaster@3.0-service.xdplus",
	stem: "android.hardware.keymaster@3.0-service.xdplus",
	defaults: ["hidl_defaults"],
	system_ext_specific: true,
	relative_install_path: "hw",
	init_rc: ["km30.rc"],
	// No vintf_fragment: the km@3.0/default HIDL declaration lives in the vendor
	// manifest, patched from passthrough to hwbinder by keymaster/tee/install.sh.
	// A duplicate framework decl would conflict at VINTF merge.
	srcs: ["km30_service.cpp"],
	shared_libs: [
		"android.hardware.keymaster@3.0",
		"libbase",
		"libcutils",
		"libdl",
		"libhardware",
		"libhidlbase",
		"libkeymaster3device",
		"liblog",
		"libutils",
	],
}

// Standalone TEE-reachability probe for the km@3.0 device (not shipped).
cc_binary {
	name: "km30_probe.xdplus",
	stem: "km30_probe",
	defaults: ["hidl_defaults"],
	system_ext_specific: true,
	srcs: ["km30_probe.cpp"],
	shared_libs: [
		"android.hardware.keymaster@3.0",
		"libbase",
		"libhardware",
		"libhidlbase",
		"libkeymaster3device",
		"liblog",
		"libutils",
	],
}

// Binderized gatekeeper@1.0 service backed by the MT8173 TEE. hw_get_module
// ("gatekeeper")s the trustlet HAL gatekeeper.mt8173.so (loadable since
// libtz_uree.so was restored, §29; enroll/verify proven by the §31 spike) and
// wraps it with the AOSP passthrough adapter (gk_tee_adapter.*). Registers as
// IGatekeeper/default so gatekeeperd's HardwareAuthToken shares the trustlet
// root of trust with the §30 HW keymaster — fixes the -26 PIN regression.
// Falls back to the software gatekeeper if the trustlet won't open.
cc_binary {
	name: "android.hardware.gatekeeper@1.0-service.xdplus",
	stem: "android.hardware.gatekeeper@1.0-service.xdplus",
	defaults: ["hidl_defaults"],
	system_ext_specific: true,
	relative_install_path: "hw",
	init_rc: ["gk_tee.rc"],
	vintf_fragments: ["gk10.xml"],
	srcs: [
		"gk_tee_service.cpp",
		"gk_tee_adapter.cpp",
		"SoftGateKeeperDevice.cpp",
	],
	shared_libs: [
		"android.hardware.gatekeeper@1.0",
		"libbase",
		"libhardware",
		"libhidlbase",
		"libutils",
		"liblog",
		"libdl",
		"libcrypto",
		"libgatekeeper",
	],
	static_libs: ["libscrypt_static"],
}

cc_binary {
	name: "android.hardware.gatekeeper@1.0-service.software.xdplus",
	stem: "android.hardware.gatekeeper@1.0-service.software.xdplus",
	defaults: ["hidl_defaults"],
	system_ext_specific: true,
	relative_install_path: "hw",
	init_rc: ["gk10.rc"],
	vintf_fragments: ["gk10.xml"],
	srcs: [
		"gk_service.cpp",
		"SoftGateKeeperDevice.cpp",
	],
	shared_libs: [
		"android.hardware.gatekeeper@1.0",
		"libbase",
		"libhardware",
		"libhidlbase",
		"libutils",
		"liblog",
		"libcrypto",
		"libgatekeeper",
	],
	static_libs: ["libscrypt_static"],
}
