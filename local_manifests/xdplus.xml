<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the GPD XD+ port.

  ⚠️ THIS FILE IS A TEMPLATE WHERE IT SITS. repo only reads
  `.repo/local_manifests/*.xml`; it is kept here so that it is versioned and
  survives, because `.repo/` is not backed up by anything.

      mkdir -p .repo/local_manifests
      cp device/gpd/xdplus/local_manifests/xdplus.xml .repo/local_manifests/

  All three projects below are pushed and public, so activating this on a fresh
  checkout is an ordinary copy. On a machine that already carries standalone
  clones at those paths it is still a migration: repo refuses to adopt them
  ("unsupported checkout state") and device/gpd/xdplus/keys/ is gitignored, so a
  fresh clone arrives with no signing keys and cannot build an installable
  update. Back the keys up first, one path at a time.

  ⚠️ `repo sync` leaves a project detached; `repo start <branch> <path>` after.
  ⚠️ The fetch base is https, which cannot authenticate on the maintainer's host,
  so each tree carries a `remote.keyaku.pushurl` in the git@github.com: form.

  packages/apps/Settings carries the in-Settings "GPD XD+" menu, so it is
  replaced here rather than added: <remove-project> drops the LineageOS project
  and the <project> below takes its path. It was patch 0029 until the fork
  existed; that number is retired, not reused.

  ⚠️ Still uncovered: packages/providers/MediaProvider, which carries patch 0028
  (the microSD setattr EPERM fallback) on a local branch with no fork. Same fix
  when a fork exists -- remove-project, project, and delete the patch in the
  same change.

  The kernel entry is what makes `TARGET_KERNEL_SOURCE := kernel/gpd/mt8176`
  (BoardConfig.mk, the in-tree kernel build) resolve on a fresh checkout.
-->
<manifest>

  <remote  name="keyaku"
           fetch="https://github.com/Keyaku" />

  <project path="kernel/gpd/mt8176"
           name="android_kernel_mt8176_common"
           remote="keyaku"
           revision="refs/heads/xdplus-los18" />

  <project path="device/gpd/xdplus"
           name="android_device_gpd_xdplus"
           remote="keyaku"
           revision="refs/heads/lineage-18.1" />

  <remove-project name="LineageOS/android_packages_apps_Settings" />

  <project path="packages/apps/Settings"
           name="android_packages_apps_Settings"
           remote="keyaku"
           groups="pdk-fs"
           revision="refs/heads/lineage-18.1" />

  <project path="vendor/gpd/xdplus"
           name="android_vendor_gpd_xdplus"
           remote="keyaku"
           revision="refs/heads/lineage-18.1" />

</manifest>
