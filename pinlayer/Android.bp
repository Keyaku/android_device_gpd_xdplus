// Diagnostic only: holds one layer on layer stack 0 at a chosen size and alpha.
// Not shipped and not run as a service -- since vendor rev 9 the composer blob
// accepts a mirror whose primary has collapsed to a single layer.
cc_binary {
	name: "xdplus_pinlayer",
	srcs: ["pinlayer.cpp"],
	compile_multilib: "64",
	shared_libs: [
		"libbinder",
		"libcutils",
		"libgui",
		"liblog",
		"libui",
		"libutils",
	],
	cflags: [
		"-Wall",
		"-Werror",
	],
}
