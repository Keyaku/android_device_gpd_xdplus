// Holds one layer on layer stack 0 while a second display is attached, so an app whose
// visible list collapses to a single layer cannot drop the mini-HDMI mirror. Runs as the
// xdplus-mirrorpin service; the same binary takes a size and alpha for measuring by hand.
cc_binary {
	name: "xdplus_pinlayer",
	srcs: ["pinlayer.cpp"],
	compile_multilib: "64",
	shared_libs: [
		"libbinder",
		"libcutils",
		"libgui",
		"liblog",
		"libui",
		"libutils",
	],
	cflags: [
		"-Wall",
		"-Werror",
	],
}
